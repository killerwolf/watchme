{
  "name": "watchme",
  "version": "0.12.0",
  "description": "macOS menu bar app that watches running processes and notifies you the moment one exits.",
  "type": "module",
  "homepage": "https://h4md1.fr/watchme/",
  "repository": {
    "type": "git",
    "url": "https://github.com/killerwolf/watchme.git"
  },
  "bugs": {
    "url": "https://github.com/killerwolf/watchme/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "test": "npm run test:unit && npm run frontend:build && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:unit": "node --test test/*.test.js",
    "frontend:dev": "vite --host 127.0.0.1",
    "frontend:build": "vite build",
    "icon:build": "rsvg-convert -w 1024 -h 1024 assets/icon.svg -o assets/icon.png",
    "sound:build": "node tools/build-notification-sound.mjs",
    "build": "tauri build",
    "build:mac": "tauri build --bundles app,dmg",
    "build:win": "tauri build --bundles nsis",
    "build:linux": "tauri build --bundles appimage,deb",
    "build:all": "tauri build",
    "dist": "npm run build",
    "pack": "tauri build --debug",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rimraf dist dist-frontend src-tauri/target"
  },
  "keywords": [
    "tauri",
    "rust",
    "process-monitor",
    "process-watcher",
    "system-monitor",
    "macos",
    "menubar",
    "tray",
    "notifications",
    "desktop-app"
  ],
  "author": "@killerwolf (https://github.com/killerwolf)",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tauri-apps/cli": "^2.5.0",
    "rimraf": "^6.1.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.4.0"
  }
}
